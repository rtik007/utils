import re
from typing import List, Union

class PiiMasker:
    def __init__(self):
        # 1) Structured PII regexes
        self.patterns = {
            "EMAIL":          re.compile(r"\b[\w\.-]+?@[\w\.-]+\.\w{2,4}\b"),
            "PHONE":          re.compile(r"\b(?:\+?\d{1,3}[\s-]?)?(?:\(?\d{3}\)?[\s-]?)?\d{3}[\s-]?\d{4}\b"),
            "SSN":            re.compile(r"\b\d{3}-\d{2}-\d{4}\b"),
            "CREDIT_CARD":    re.compile(r"\b(?:\d[ -]*?){13,16}\b"),
            "BANK_ACCOUNT":   re.compile(r"\b\d{8,17}\b"),
            "VIN":            re.compile(r"\b(?!.*[IOQ])[A-HJ-NPR-Z0-9]{17}\b"),
            "IP_ADDRESS":     re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b"),
            "URL":            re.compile(r"\bhttps?://[^\s]+\b"),
            "DATE":           re.compile(r"\b(?:\d{1,2}[/-]\d{1,2}[/-]\d{2,4}|\d{4}-\d{2}-\d{2})\b"),
            "PASSPORT":       re.compile(r"\b[A-Z]\d{8}\b"),
            "DRIVER_LICENSE": re.compile(r"\b[A-Z]{1,2}\d{4,8}\b"),
        }
        # 2) multi-word proper nouns (2+ Title-cased words)
        self.entity_multi = re.compile(r"\b([A-Z][a-z]+(?:\s+[A-Z][a-z]+)+)\b")
        # 3) single Title-cased word
        self.entity_single = re.compile(r"\b([A-Z][a-z]+)\b")

    def mask(self, data: Union[str, List[str]]) -> List[str]:
        texts = [data] if isinstance(data, str) else data
        out = []
        for text in texts:
            t = text
            # Phase 1: structured PII
            for label, pat in self.patterns.items():
                t = pat.sub(f"[{label}]", t)
            # Phase 2: mask multi-word entities everywhere
            t = self.entity_multi.sub(r"[ENTITY]", t)
            # Phase 3: mask single-word entities everywhere
            t = self.entity_single.sub(r"[ENTITY]", t)
            out.append(t)
        return out

    sample = [
        "John Doe went to New York City on 2025-05-22. His SSN is 123-45-6789.",
        "Contact Alice at alice@example.com or +1-202-555-0173 in Bangalore. VIN: 1HGCM82633A004352."
    ]
    masker = PiiMasker()
    for orig, masked in zip(sample, masker.mask(sample)):
        print("Original:", orig)
        print("Masked:  ", masked)
